# ---- Variáveis do Vercel para o Wine (Settings > Environment Variables) ----
# OBRIGATÓRIAS. Duas senhas DIFERENTES entre si e DIFERENTES do INBOX_SECRET / WEBHOOK_SECRET.
# Gere cada uma com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WINE_BOT_TOKEN=cole_aqui_uma_senha_longa_para_o_bot
WINE_NODE_TOKEN=cole_aqui_outra_senha_longa_para_os_PCs
# Redis: KV_REST_API_URL + KV_REST_API_TOKEN ou UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# OPCIONAIS
# WINE_MAX_WAIT_S=8
# WINE_NODE_TTL_S=90
# WINE_MAX_MSG=800000
# WINE_PREFIX=wine
