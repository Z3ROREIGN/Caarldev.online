# ---- Variáveis do Vercel para o Wine (Settings > Environment Variables) ----
# OBRIGATÓRIAS. Duas senhas DIFERENTES entre si e DIFERENTES das outras senhas do projeto.
# Gere cada uma com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WINE_BOT_TOKEN=cole_aqui_uma_senha_longa_para_o_bot
WINE_NODE_TOKEN=cole_aqui_outra_senha_longa_para_os_PCs
# Redis: KV_REST_API_URL + KV_REST_API_TOKEN ou UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# OPCIONAIS
# WINE_MAX_WAIT_S=8
# WINE_NODE_TTL_S=90
# WINE_MAX_MSG=800000
# WINE_PREFIX=wine

# ---- Variáveis da LOJA (Settings > Environment Variables) ----
# OBRIGATÓRIAS
# Seu e-mail de admin. Quem criar a conta com esse e-mail já vira admin. Vários: separe por vírgula.
ADMIN_EMAIL=seu@email.com
# Senha longa e aleatória que assina o login. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=cole_aqui_uma_senha_longa_e_aleatoria
# O banco Redis (Upstash) é o mesmo do Wine: KV_REST_API_URL + KV_REST_API_TOKEN

# ---- Pagamento PIX automático (MisticPay) ----
# Chave de acesso criada em MisticPay > API > Chaves de Acesso, com os escopos TRANSACTION_CREATE e TRANSACTION_READ.
# O sk_ aparece uma única vez. Não use IPs autorizados na MisticPay (o Vercel não tem IP fixo).
MISTICPAY_CLIENT_ID=pk_cole_aqui
MISTICPAY_CLIENT_SECRET=sk_cole_aqui
# OPCIONAL: endereço público do site, só se o domínio do webhook sair errado (ex.: https://seusite.com)
# SITE_URL=https://seusite.com

# ---- Novidades da versão 2 (todas opcionais) ----
# Avisos no Discord: webhook do canal (Editar canal > Integrações > Webhooks). Também dá para colar no painel (Configurações).
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Chave para criar a conta do administrador (ADMIN_EMAIL). Sem verificação de e-mail, impede que outra pessoa registre esse e-mail antes de você.
# ADMIN_SETUP_KEY=uma-frase-longa-e-secreta
